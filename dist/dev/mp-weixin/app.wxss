/*每个页面公共css */
.filter-grid-item {
  width: 214rpx;
  height: 74rpx;
  line-height: 74rpx;
  margin-bottom: 20rpx;
  background-color: #f5f5f5;
  font-size: 26rpx;
  color: #222;
  border-radius: 16rpx;
  text-align: center;
}
.filter-grid-item.active {
  background-color: rgba(15, 161, 254, 0.1);
  color: #0fa1fe;
}
.filter-grid-item:nth-child(3n-1) {
  margin: 0 20rpx;
}
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background-color: transparent;
}page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}