.filter {
  box-sizing: border-box;
  position: fixed;
  top: 176rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 50rpx;
  background: #fff;
}
.filter-item {
  flex: 1;
  display: flex;
  justify-content: center;
}
.filter-item .text {
  margin-right: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}
.filter-item .text.active {
  color: #0fa1fe;
}
.filter-item .text.region {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: -moz-fit-content;
  width: fit-content;
  max-width: 92rpx;
}
.filter-item .text.price {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 120rpx;
}
.filter-item .text.houseType {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-item .text.houseType.single {
  width: -moz-fit-content;
  width: fit-content;
  max-width: 115rpx;
}
.filter-item .text.houseType.multiple {
  width: 120rpx;
}
.filter-item .text.sort {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 130rpx;
}
.list {
  position: fixed;
  top: 264rpx;
  bottom: 0;
  left: 0;
  right: 0;
  width: 690rpx;
  padding: 0 30rpx;
  background: #f5f5f5;
}
.list .main {
  padding: 20rpx 0 5rpx;
}