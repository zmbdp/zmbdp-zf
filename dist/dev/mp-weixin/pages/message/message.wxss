.session {
  box-sizing: border-box;
  position: fixed;
  top: 176rpx;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 30rpx 0;
  background: #f5f5f5;
}
.session .noLogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 350rpx;
}
.session .noLogin .text {
  font-size: 26rpx;
  color: #999;
}
.session .noLogin .btn-login {
  width: 260rpx;
  height: 88rpx;
  margin-top: 30rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  color: #fff;
  background: linear-gradient(to right, #22cfff, #0fa1fe);
}
.session .noContent {
  margin-top: 240rpx;
}
.session .session-list {
  background: #fff;
  border-radius: 16rpx;
}
.session .tips {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
}
.session .tips .line {
  width: 108rpx;
  height: 3rpx;
}
.session .tips .line.left {
  background: linear-gradient(to left, #c9c9c9, #f5f5f5);
}
.session .tips .line.right {
  background: linear-gradient(to right, #c9c9c9, #f5f5f5);
}
.session .tips .text {
  margin: 0 10rpx;
  font-size: 26rpx;
  color: #999;
}