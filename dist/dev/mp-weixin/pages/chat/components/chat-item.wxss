.time {
  padding: 15rpx 0;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.msg {
  display: flex;
  padding: 15rpx 0;
}
.msg.self {
  justify-content: flex-end;
}
.msg.self .avatar {
  margin-left: 20rpx;
}
.msg.fangdong {
  justify-content: flex-start;
}
.msg.fangdong .avatar {
  margin-right: 20rpx;
}
.msg.msg_card .card {
  width: 490rpx;
  height: 200rpx;
}
.msg.msg_text .text {
  box-sizing: border-box;
  width: -moz-fit-content;
  width: fit-content;
  max-width: 490rpx;
  padding: 26rpx 25rpx 26rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #222;
}
.msg.msg_text.self .text {
  background: #d4e2fc;
}
.msg.msg_text.fangdong .text {
  background: #fff;
}
.msg.msg_voice .voice {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
}
.msg.msg_voice .voice .duration {
  font-size: 26rpx;
  color: #222;
}
.msg.msg_voice .voice .icon {
  position: relative;
}
.msg.msg_voice.self .voice {
  justify-content: flex-end;
  background: #d4e2fc;
}
.msg.msg_voice.self .voice .duration {
  margin-right: 14rpx;
}
.msg.msg_voice.self .voice .icon {
  top: 6rpx;
}
.msg.msg_voice.fangdong .voice {
  position: relative;
  background: #fff;
}
.msg.msg_voice.fangdong .voice .icon {
  top: -3rpx;
  transform: rotate(180deg);
}
.msg.msg_voice.fangdong .voice .duration {
  margin-left: 14rpx;
}
.msg.msg_voice.fangdong .voice .red_dot {
  position: absolute;
  right: -26rpx;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-top: -8rpx;
  border-radius: 50%;
  background: #f50102;
}
.msg.msg_image .image {
  max-width: 490rpx;
}