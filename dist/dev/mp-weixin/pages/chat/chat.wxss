.chat {
  box-sizing: border-box;
  position: fixed;
  top: 176rpx;
  left: 0;
  right: 0;
  padding: 15rpx 30rpx;
  background: #f5f5f5;
}
.chat .chatBottom {
  width: 100%;
  height: 1rpx;
  background: transparent;
}
.action {
  box-sizing: border-box;
  position: fixed;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 20rpx 30rpx;
  background: #fff;
}
.action .middle .input,
.action .middle .longpress {
  width: 456rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: #f2f2f4;
  color: #999;
}
.action .middle .input {
  box-sizing: border-box;
  padding-left: 20rpx;
}
.action .middle .longpress {
  text-align: center;
}
.action .right .btn-send {
  width: 132rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: #0fa1fe;
  color: #fff;
}
.action .right .icon {
  margin-right: 24rpx;
}
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 690rpx;
  height: 490rpx;
  padding: 0 30rpx;
  background: #d8d8d8;
}
.modal {
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  top: 176rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 120rpx);
  bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  left: 0;
  right: 0;
  background: transparent;
}
.modal .content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 360rpx;
  height: 360rpx;
  border-radius: 36rpx;
  background: rgba(0, 0, 0, 0.5);
}
.modal .content .text {
  margin-top: 30rpx;
  font-size: 30rpx;
  color: #fff;
}