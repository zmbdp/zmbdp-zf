.index-city {
  margin-right: 8rpx;
  font-size: 28rpx;
  color: #222;
}
.index {
  box-sizing: border-box;
  position: fixed;
  top: 176rpx;
  bottom: 0;
  width: 100%;
  padding: 0 30rpx;
  background: #f5f5f5;
}
.index.active {
  padding: 0;
}
.index-banner {
  padding-top: 30rpx;
}
.index-banner__image {
  width: 690rpx;
  height: 222rpx;
}
.index-diamond {
  display: flex;
  justify-content: space-between;
  width: 690rpx;
  margin: 28rpx 0 30rpx;
}
.index-diamond-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.index-diamond-item .text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #222;
}
.index-filter {
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 690rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  padding: 0 44rpx 0 50rpx;
  border-radius: 16rpx;
  background: #fff;
}
.index-filter.fixedTop {
  box-sizing: border-box;
  position: fixed;
  top: 176rpx;
  left: 0;
  width: 100%;
  border-radius: 0;
  border-bottom: 1rpx solid #e9e9e9;
}
.index-filter-item {
  display: flex;
}
.index-filter-item .text {
  width: -moz-fit-content;
  width: fit-content;
  margin-right: 3rpx;
  font-size: 26rpx;
  color: #222;
}
.index-filter-item .text.active {
  color: #0fa1fe;
}
.index-filter-item .text.price {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 120rpx;
}
.index-filter-item .text.houseType.single {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: -moz-fit-content;
  width: fit-content;
  max-width: 115rpx;
}
.index-filter-item .text.houseType.multiple {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 120rpx;
}
.index-filter-item .text.sort {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 130rpx;
}
.index-houseList {
  width: 690rpx;
  padding-bottom: 5rpx;
}
.index-houseList.active {
  box-sizing: border-box;
  width: 750rpx;
  margin-top: 128rpx;
  padding: 0 30rpx 5rpx;
}