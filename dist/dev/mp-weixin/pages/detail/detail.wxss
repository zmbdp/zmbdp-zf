.detail {
  position: fixed;
  top: 176rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 114rpx);
  bottom: calc(env(safe-area-inset-bottom) + 114rpx);
  left: 0;
  right: 0;
  background: #fff;
}
.detail .title {
  font-weight: 600;
  color: #222;
}
.detail .title.main-title {
  font-size: 36rpx;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.detail .title.sub-title {
  font-size: 32rpx;
}
.detail .swiper {
  position: relative;
  width: 750rpx;
  height: 530rpx;
}
.detail .swiper-list {
  width: 100%;
  height: 100%;
}
.detail .swiper-list .swiper-image {
  width: 750rpx;
  height: 530rpx;
}
.detail .swiper-statics {
  position: absolute;
  right: 30rpx;
  bottom: 60rpx;
  padding: 10rpx 30rpx;
  border-radius: 27rpx;
  background: rgba(0, 0, 0, 0.5);
}
.detail .swiper-statics .text {
  font-size: 26rpx;
  color: #fff;
}
.detail .info1 {
  box-sizing: border-box;
  position: relative;
  top: -30rpx;
  padding: 30rpx;
  border-bottom: 12rpx solid #f5f5f5;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}
.detail .info1 .price {
  display: flex;
  align-items: baseline;
  margin: 15rpx 0;
  font-weight: 600;
  color: #ff5c02;
}
.detail .info1 .price .rmb,
.detail .info1 .price .perMonth {
  font-size: 24rpx;
}
.detail .info1 .price .num {
  font-size: 42rpx;
}
.detail .info1 .prop {
  box-sizing: border-box;
  display: flex;
  width: 690rpx;
  height: 142rpx;
  padding: 0 30rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}
.detail .info1 .prop-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 157.5rpx;
  margin-right: 15rpx;
}
.detail .info1 .prop-item:last-child {
  margin-right: 0;
}
.detail .info1 .prop-item-key {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}
.detail .info1 .prop-item-value {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.detail .info1 .tag {
  display: flex;
  margin-top: 30rpx;
  padding: 0 21rpx;
}
.detail .info1 .tag-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-right: 54rpx;
}
.detail .info1 .tag-item:last-child {
  margin-right: 0;
}
.detail .info1 .tag-item-text {
  font-size: 24rpx;
  color: #333;
}
.detail .info2 {
  padding: 0 30rpx 30rpx;
  background: #fff;
}
.detail .info2 .xiaoqu .map {
  width: 690rpx;
  height: 260rpx;
  margin-top: 20rpx;
}
.detail .info2 .intro .sub-title {
  margin: 40rpx 0 20rpx;
}
.detail .info2 .intro .text {
  line-height: 1.5;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
}
.detail .info2 .device .sub-title {
  margin: 30rpx 0 20rpx;
}
.detail .info2 .device .list {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}
.detail .info2 .device .list .item {
  display: flex;
  align-items: center;
  width: 172.5rpx;
  margin-bottom: 16rpx;
}
.detail .info2 .device .list .item .name {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #333;
}
.detail .info2 .heyan {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 690rpx;
  height: 80rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}
.detail .info2 .heyan .icon {
  position: relative;
  top: 6rpx;
}
.detail .info2 .heyan .text {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
}
.footer {
  box-sizing: border-box;
  position: fixed;
  bottom: calc(constant(safe-area-inset-bottom) + 0rpx);
  bottom: calc(env(safe-area-inset-bottom) + 0rpx);
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 114rpx;
  padding: 0 30rpx;
  border-top: 1rpx solid #e9e9e9;
  background: #fff;
}
.footer .btn-share {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 80rpx;
  padding: 0;
  border: none;
}
.footer .btn-share .icon {
  width: 44rpx;
  height: 40rpx;
}
.footer .btn-share .text {
  width: 44rpx;
  font-size: 22rpx;
  color: #222;
}
.footer .btn-consult {
  width: 606rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(to right, #22cfff, #0fa1fe);
}