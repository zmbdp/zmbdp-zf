.edit .body {
  position: fixed;
  top: 176rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 108rpx);
  bottom: calc(env(safe-area-inset-bottom) + 108rpx);
  box-sizing: border-box;
  width: 750rpx;
  padding: 21rpx 30rpx 0;
  background: #f5f5f5;
}
.edit .body .main {
  padding: 0 20rpx 0 57rpx;
  background: #fff;
  border-radius: 16rpx;
}
.edit .body .main .cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}
.edit .body .main .cell.touxiang {
  border-bottom: 1rpx solid #e9e9e9;
}
.edit .body .main .cell .left {
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
}
.edit .body .main .cell .right {
  display: flex;
  align-items: center;
}
.edit .body .main .cell .right .avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  border-radius: 50%;
}
.edit .body .main .cell .right .input {
  width: 170rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  text-align: right;
  color: #999;
}
.edit .footer {
  position: fixed;
  left: 0;
  bottom: calc(constant(safe-area-inset-bottom) + 0rpx);
  bottom: calc(env(safe-area-inset-bottom) + 0rpx);
  padding: 14rpx 30rpx;
  background: #fff;
}
.edit .footer .btn-submit {
  width: 690rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  background: linear-gradient(to right, #22cfff, #0fa1fe);
  color: #fff;
}