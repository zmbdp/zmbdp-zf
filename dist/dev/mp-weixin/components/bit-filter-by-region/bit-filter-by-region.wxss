.bit-filter-by-region {
  z-index: 2;
  position: relative;
}
.bit-filter-by-region .region-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  border-top: 1rpx solid #e9e9e9;
}
.bit-filter-by-region .region-item__text {
  font-size: 28rpx;
  color: #222;
}
.bit-filter-by-region .region-item__text.active {
  color: #0fa1fe;
}