.bit-filter-by-sort {
  z-index: 2;
  position: relative;
  padding: 0 24rpx;
}
.bit-filter-by-sort .sort-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  border-top: 1rpx solid #e9e9e9;
}
.bit-filter-by-sort .sort-item__text {
  font-size: 28rpx;
  color: #222;
}
.bit-filter-by-sort .sort-item__text.active {
  color: #0fa1fe;
}